# ── Goal ─────────────────────────────────────────────
# 사용할 도구 번호 (1~3). 도구 위치는 액션 서버 코드에 고정되어 있음
int32 tool_id
# 작업 시작/종료 위치 (베이스 좌표계) [x, y, z (mm), rx, ry, rz (deg)]
# 나중에 DB에서 읽어서 넣을 값
float64[6] start_posx
float64[6] end_posx
# true면 작업 후 도구를 원래 자리에 반납하고 홈으로 복귀
bool return_tool
---
# ── Result ───────────────────────────────────────────
bool success
string message
---
# ── Feedback ─────────────────────────────────────────
int32 step
int32 total_steps
string stage
