# 작업: initialize / pickup / scoop / load / apply / return
string task
# 실제 컨트롤러=false, 가상 컨트롤러=true. 연결된 시스템과 다르면 실행 거절.
bool virtual_mode
# 실물 scoop 작업의 사용자 파지 확인. 센서 판정이 아님.
bool tool_held_confirmed
# 해당 작업의 기존 CLI 설정 토큰. --execute-motion/ROS 설정은 서버가 관리.
# apply 예: [--floor-force, '2.3', --wall-force, '2.3', --press-force, '6']
string[] arguments
---
bool success
string message
int32 exit_code
# 로봇 STANDBY 확인 여부. 취소 시 정지/힘 해제까지 성공해야 canceled 결과 반환.
bool stop_confirmed
---
string task
string stage
float64 elapsed_sec
# 중간 진행률을 정확히 계산할 수 없으면 -1. 성공 시 1.
float32 progress
bool pose_valid
float64[6] tcp_pose
bool force_valid
float64[6] tool_force
# 원본 작업 로그. 위치/힘은 BASE 기준이며 순차 조회값.
string log_line
